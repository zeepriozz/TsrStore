<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Userlogin"
    android:background="@color/white1"
    >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">



    <ImageView
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:src="@drawable/loginback"
        android:scaleType="centerCrop"
        android:layout_alignParentTop="true"
        android:id="@+id/gif" >
    </ImageView>
    </RelativeLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="130dp"
        >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to"
        android:textSize="25dp"
        android:layout_alignParentTop="true"
        android:textColor="@color/white1"
        android:textStyle="italic"
         />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tsr Store,"
        android:textSize="25dp"
        android:layout_alignParentTop="true"
        android:textColor="@color/white"
        android:layout_marginLeft="5dp"
        android:textStyle="italic|bold"

        />

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="200dp"
        android:padding="20dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="30dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Title Text -->


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Let's Sign up!"
                    android:textSize="20sp"
                    android:textStyle="bold|italic"
                    android:textColor="@color/black" />

                <!-- Input Fields -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    app:boxStrokeColor="@color/black"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp">

                    <EditText
                        android:id="@+id/Userregistername2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="User Name"
                        android:background="@drawable/custominput"
                        android:drawableLeft="@drawable/baseline_person_24"
                        android:padding="15dp"
                        android:textColor="@color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    app:boxStrokeColor="@color/black"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp">

                    <EditText
                        android:id="@+id/Userregisteremail2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Email"
                        android:background="@drawable/custominput"
                        android:drawableLeft="@drawable/baseline_email_24"
                        android:padding="15dp"
                        android:textColor="@color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    app:boxStrokeColor="@color/black"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp">

                    <EditText
                        android:id="@+id/Userregisterphone2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Phone No"
                        android:background="@drawable/custominput"
                        android:drawableLeft="@drawable/baseline_local_phone_24"
                        android:padding="15dp"
                        android:textColor="@color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    app:boxStrokeColor="@color/black"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp">

                    <EditText
                        android:id="@+id/Userregisterpassword2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Address"
                        android:background="@drawable/custominput"
                        android:padding="15dp"
                        android:textColor="@color/black" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Submit Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/Userregitersubmit2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Register"
                    android:layout_marginTop="20dp"
                    android:layout_gravity="center"
                    android:background="@drawable/gradient"
                    >


                </androidx.appcompat.widget.AppCompatButton>



                <!-- Link to Login -->

            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/rlog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Already have an account? Login"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:textStyle="italic"
            android:textColor="@color/black" />
    </LinearLayout>
</RelativeLayout>
